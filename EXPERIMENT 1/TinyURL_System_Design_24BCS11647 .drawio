        </mxCell>
        <mxCell id="fr_note" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="Basic flow: Create short URL → Store mapping → Redirect when short URL is opened." vertex="1">
          <mxGeometry height="70" width="770" x="170" y="585" as="geometry" />
        </mxCell>
        <mxCell id="fr_actor" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="User" vertex="1">
