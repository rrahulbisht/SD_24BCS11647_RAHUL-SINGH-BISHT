        <mxCell id="fr_title" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=16;" value="TinyURL — Functional Requirements" vertex="1">
          <mxGeometry height="50" width="1050" x="40" y="30" as="geometry" />
        </mxCell>
        <mxCell id="fr1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="1. User enters a long URL and gets a short URL." vertex="1">
          <mxGeometry height="55" width="970" x="70" y="110" as="geometry" />
        </mxCell>
        <mxCell id="fr2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="2. Short URL redirects to the original long URL." vertex="1">
          <mxGeometry height="55" width="970" x="70" y="185" as="geometry" />
        </mxCell>
        <mxCell id="fr3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="3. Each generated short URL is unique." vertex="1">
          <mxGeometry height="55" width="970" x="70" y="260" as="geometry" />
        </mxCell>
        <mxCell id="fr4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="4. System stores the short URL → long URL mapping." vertex="1">
          <mxGeometry height="55" width="970" x="70" y="335" as="geometry" />
        </mxCell>
        <mxCell id="fr5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="5. Invalid / missing URLs should show an error." vertex="1">
          <mxGeometry height="55" width="970" x="70" y="410" as="geometry" />
        </mxCell>
        <mxCell id="fr6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="6. Optional: User can request a custom alias." vertex="1">
